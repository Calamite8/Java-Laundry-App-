<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Matches what NetBeans generated for you: com.mycompany:LaundrySystem:1.0-SNAPSHOT -->
    <groupId>com.mycompany</groupId>
    <artifactId>LaundrySystem</artifactId>
    <version>1.1</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <exec.mainClass>laundrysystem.Main</exec.mainClass>
    </properties>

    <!--
      IMPORTANT: paste this <dependencies> block directly into your pom.xml's
      source (right-click pom.xml > Open, edit the XML text) rather than using
      NetBeans' "Add Dependency" search dialog. That search can return
      similarly-named third-party mirrors (e.g. org.wso2.orbit... or
      club.gclmit:sabre-utils) instead of the official artifacts below, which
      is what caused the earlier BUILD FAILURE. All versions here were
      verified against Maven Central directly.
    -->
    <dependencies>

        <!-- MySQL JDBC driver -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>9.7.0</version>
        </dependency>

        <!-- QR code generate/decode -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.4</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>3.5.4</version>
        </dependency>

        <!-- Google Sheets API -->
        <dependency>
            <groupId>com.google.api-client</groupId>
            <artifactId>google-api-client</artifactId>
            <version>2.9.0</version>
        </dependency>
        <dependency>
            <groupId>com.google.apis</groupId>
            <artifactId>google-api-services-sheets</artifactId>
            <version>v4-rev20260610-2.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.google.auth</groupId>
            <artifactId>google-auth-library-oauth2-http</artifactId>
            <version>1.48.0</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Allows you to run inside NetBeans via exec:java -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <mainClass>${exec.mainClass}</mainClass>
                </configuration>
            </plugin>

            <!--
              Packages Main and ALL external dependencies into one executable jar.

              Using shade instead of assembly here on purpose: assembly's default
              merge silently drops META-INF/services files when more than one
              dependency defines one at the same path. Both the MySQL driver
              (java.sql.Driver auto-registration) and the Google auth libraries
              rely on that mechanism via ServiceLoader, so an assembly-built jar
              can run fine under exec:java (classpath, no merging involved) and
              then mysteriously fail to find the MySQL driver, or fail auth
              provider lookups, once packaged. The ServicesResourceTransformer
              below merges those files correctly instead of overwriting them.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${exec.mainClass}</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <!-- google-api-client / google-auth transitively pull in signed jars;
                                     leaving their signature files in a merged jar throws
                                     "Invalid signature file digest" at runtime. Strip them. -->
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>